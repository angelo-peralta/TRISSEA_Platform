    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "drizzle-orm": "0.45.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": { "@nestjs/testing": "11.1.28" }
}
