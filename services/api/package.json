    "@nestjs/platform-fastify": "11.2.8",
    "@redis/client": "6.3.1",
    "cookie": "1.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.15",
    "openid-client": "6.8.9",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8"
  }
}
