# LOCAL DEVELOPMENT ONLY. Copy to .env and change the password.
NODE_ENV=development
POSTGRES_DB=trissea_dev
POSTGRES_USER=trissea_dev
POSTGRES_PASSWORD=change_me_for_local_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trissea_dev:change_me_for_local_dev@127.0.0.1:5432/trissea_dev
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
API_PORT=4000
TZ=UTC
# Do not put production secrets, real SMS/FCM keys, user records or map tokens here.
# M2 passenger auth is disabled in the regular M1 environment.
M2_PASSENGER_AUTH_ENABLED=false
M2_DRIVER_AUTH_ENABLED=false
# Use pnpm passenger:prepare for a NEW dedicated disposable local-synthetic DB,
# ignored keys and .env.m2-passenger. Never substitute DATABASE_URL from above.

# M2.5 uses a separate .env.local generated once by keycloak:prepare.
# These empty values are reference names, not working credentials.
M2_ADMIN_AUTH_ENABLED=false
ADMIN_SECURITY_MODE=local-synthetic
ADMIN_ORIGIN=http://127.0.0.1:5174
ADMIN_API_PROXY_TARGET=http://127.0.0.1:4102
KEYCLOAK_ISSUER=http://127.0.0.1:18080/realms/trissea-local
KEYCLOAK_CLIENT_ID=trissea-admin-bff
KEYCLOAK_ASSURANCE_CLIENT_ID=trissea-assurance-reader
KEYCLOAK_BFF_SECRET=
KEYCLOAK_ASSURANCE_SECRET=
KEYCLOAK_DB_OWNER_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_USER=
KEYCLOAK_BOOTSTRAP_PASSWORD=
ADMIN_DATABASE_URL=
ADMIN_KEYS_FILE=.cache/m2-keycloak/keys.json
ADMIN_IDLE_SECONDS=900
ADMIN_REAUTH_SECONDS=300
SMS_PROVIDER=mock
SMS_LIVE_ENABLED=false
RECOVERY_ENABLED=false
REAL_DOCUMENTS_ENABLED=false
OPERATIONAL_SERVICES_ENABLED=false
