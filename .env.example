# LOCAL DEVELOPMENT ONLY. Copy to .env and change the password.
NODE_ENV=development
POSTGRES_DB=trissea_dev
POSTGRES_USER=trissea_dev
POSTGRES_PASSWORD=change_me_for_local_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trissea_dev:change_me_for_local_dev@127.0.0.1:5432/trissea_dev
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
API_PORT=4000
TZ=UTC
# Do not put production secrets, real SMS/FCM keys, user records or map tokens here.
# M2 passenger auth is disabled in the regular M1 environment.
M2_PASSENGER_AUTH_ENABLED=false
M2_DRIVER_AUTH_ENABLED=false
# Use pnpm passenger:prepare for a NEW dedicated disposable local-synthetic DB,
# ignored keys and .env.m2-passenger. Never substitute DATABASE_URL from above.
