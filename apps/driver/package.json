    "typecheck": "tsc --noEmit",
    "check": "expo install --check",
    "export": "expo export --platform web"
  },
  "dependencies": {
    "expo": "57.0.15",
    "expo-router": "57.0.15",
    "expo-constants": "57.0.13",
    "expo-linking": "57.0.7",
    "expo-status-bar": "57.0.1",
    "expo-dev-client": "57.0.14",
    "@expo/metro-runtime": "57.0.12",
    "@expo/log-box": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "0.21.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "@trissea/mobile-ui": "workspace:*",
    "@trissea/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.17"
