{
  "name": "@trissea/driver",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node ../../scripts/start-mobile-identity.mjs driver",
    "web": "expo start --web --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "check": "node ../../scripts/run-expo.mjs driver install --check",
    "export": "node ../../scripts/run-expo.mjs driver export"
  },
  "dependencies": {
    "expo": "57.0.32",
    "expo-router": "57.0.30",
    "expo-constants": "57.0.23",
    "expo-linking": "57.0.13",
    "expo-status-bar": "57.0.1",
    "expo-dev-client": "57.0.21",
    "@expo/metro-runtime": "57.0.18",
    "@expo/log-box": "57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "@trissea/mobile-ui": "workspace:*",
    "@trissea/mobile-auth": "workspace:*",
    "expo-crypto": "57.0.4",
    "expo-secure-store": "57.0.4",
    "@trissea/design-tokens": "workspace:*",
    "react-native-worklets": "0.10.1",
    "@react-native/metro-config": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "expo-system-ui": "57.0.4"
  },
  "devDependencies": {
    "@types/react": "19.2.17"
  }
}
