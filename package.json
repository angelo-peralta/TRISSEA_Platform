{
  "name": "trissea-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @trissea/api dev",
    "dev:admin": "pnpm --filter @trissea/admin dev",
    "dev:passenger": "pnpm --filter @trissea/passenger dev",
    "dev:driver": "pnpm --filter @trissea/driver dev",
    "infra:up": "docker compose --env-file .env -f infra/compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose.yml down",
    "db:up": "node --env-file=.env scripts/migrate.mjs up",
    "db:down": "node --env-file=.env scripts/migrate.mjs down",
    "db:status": "node --env-file=.env scripts/migrate.mjs status",
    "db:verify": "node --env-file=.env scripts/verify-infra.mjs",
    "db:verify:rollback": "node --env-file=.env scripts/verify-infra.mjs --rolled-back",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm test:client && pnpm --filter @trissea/api test && node --test tests/*.test.mjs",
    "test:client": "tsc -p packages/contracts/tsconfig.test.json && node --test .cache/contract-tests/test/*.test.js",
    "test:policy": "tsc -p services/api/tsconfig.policy.json && node --test .cache/policy-tests/test/*.test.js",
    "build": "pnpm --filter @trissea/api build && pnpm --filter @trissea/admin build",
    "mobile:check": "pnpm --filter @trissea/passenger check && pnpm --filter @trissea/driver check",
    "mobile:doctor": "expo-doctor apps/passenger && expo-doctor apps/driver",
    "mobile:export": "pnpm --filter @trissea/passenger export && pnpm --filter @trissea/driver export",
    "audit:dependencies": "pnpm audit --audit-level=moderate",
    "validate": "pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:identity:db": "pnpm --filter @trissea/api exec tsc && node --env-file-if-exists=.env.m2-test --test scripts/test-identity-database.mjs",
    "test:authorization:db": "pnpm --filter @trissea/api exec tsc && node --env-file-if-exists=.env.m2-test --test scripts/test-authorization-database.mjs",
    "test:passenger:auth": "pnpm --filter @trissea/api exec tsc && tsc -p packages/contracts/tsconfig.test.json && node --env-file-if-exists=.env.m2-test --test scripts/test-passenger-auth.mjs",
    "test:driver:auth": "pnpm --filter @trissea/api exec tsc && tsc -p packages/contracts/tsconfig.test.json && node --env-file-if-exists=.env.m2-test --test scripts/test-driver-auth.mjs",
    "passenger:prepare": "pnpm --filter @trissea/api build && node --env-file=.env.m2-test scripts/prepare-passenger-local.mjs",
    "dev:passenger:api": "node --env-file=.env.m2-passenger services/api/dist/main.js",
    "driver:prepare": "pnpm --filter @trissea/api build && node --env-file=.env.m2-test scripts/prepare-passenger-local.mjs --driver",
    "dev:driver:api": "node --env-file=.env.m2-driver services/api/dist/main.js",
    "admin:prepare": "pnpm --filter @trissea/api build && node --env-file=.env.local scripts/prepare-admin-database.mjs",
    "test:admin:auth": "pnpm --filter @trissea/api exec tsc && node --test scripts/test-admin-auth.mjs",
    "test:verification": "pnpm --filter @trissea/api exec tsc && tsc -p packages/contracts/tsconfig.test.json && node --test scripts/test-verification.mjs",
    "keycloak:prepare": "node scripts/prepare-keycloak-local.mjs",
    "dev:admin:api": "node --env-file=.env.local services/api/dist/main.js",
    "keycloak:provision": "node --env-file=.env.local scripts/provision-keycloak-local.mjs",
    "keycloak:up": "docker compose --env-file .env.local -f infra/compose.m2-keycloak.yml up -d --wait",
    "dev:admin:identity": "node --env-file=.env.local apps/admin/node_modules/vite/bin/vite.js --config apps/admin/vite.config.ts apps/admin"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@expo/config-plugins": "57.0.11",
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.2",
    "globals": "17.11.0",
    "otpauth": "9.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "postgres": "3.4.9"
  }
}
