# Contract only. No production activation is authorized in M2.
# Inject process variables/secrets; never load .env.local in production.
NODE_ENV=production
M2_ADMIN_AUTH_ENABLED=false
M2_PASSENGER_AUTH_ENABLED=false
M2_DRIVER_AUTH_ENABLED=false
ADMIN_SECURITY_MODE=production
ADMIN_ORIGIN=https://admin.example.invalid
KEYCLOAK_ISSUER=https://identity.example.invalid/realms/trissea
KEYCLOAK_CLIENT_ID=trissea-admin-bff
KEYCLOAK_ASSURANCE_CLIENT_ID=trissea-assurance-reader
KEYCLOAK_BFF_SECRET=
KEYCLOAK_ASSURANCE_SECRET=
ADMIN_DATABASE_URL=
ADMIN_KEYS_FILE=
ADMIN_IDLE_SECONDS=900
ADMIN_REAUTH_SECONDS=300
SMS_PROVIDER=philsms
SMS_LIVE_ENABLED=false
RECOVERY_ENABLED=false
REAL_DOCUMENTS_ENABLED=false
OPERATIONAL_SERVICES_ENABLED=false
API_PORT=4000
# Hardened Keycloak startup, HTTPS/proxy/hostname, credentials, storage, backup,
# restore, rotation and monitoring must be reviewed before enabling this contract.
# start-dev, temporary master bootstrap and local fixture commands are prohibited.
